---
import Base from "../layouts/BaseLayout.astro";
import ReadingCover from "../components/ReadingCover.astro";
import currentlyReading from "../data/reading/currently-reading.json";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;
---
<Base
  title="Now | Reuben Ingber"
  description="What Reuben Ingber is focused on right now: work, family, and hobbies."
>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold mb-4 text-primary tracking-wide">NOW</h1>

    <div class="space-y-10 mt-8">
      <section>
        <h2 class="text-2xl font-bold mb-3 text-primary tracking-wide">FAMILY</h2>
        <p class="text-lg leading-relaxed">
          Raising two amazing kids. Navigating the beginning of second grade for Zeke and a new school for Judi — after <a href="https://reubeningber.com/articles/2026-08-31-how-i-finally-tamed-the-school-calendar-chaos/" class="text-accent hover:underline font-semibold">finally taming the school calendar chaos</a>, we built <a href="https://reubeningber.com/articles/2026-09-16-the-zeke-and-judi-weekly-briefing/" class="text-accent hover:underline font-semibold">a weekly briefing</a> to keep us on top of it. Planning activities through the end of the year, including trips to Syracuse and Atlanta. And a few reflections on <a href="https://reubeningber.com/articles/2026-07-22-7-things-ive-learned-in-7-years/" class="text-accent hover:underline font-semibold">7 things I've learned in 7 years</a> of fatherhood.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3 text-primary tracking-wide">HOBBIES</h2>
        <p class="text-lg leading-relaxed">
          Photography, using more AI in my daily life, trying hard to get back into fitness/running (<a href="https://reubeningber.com/articles/2026-08-26-rebuilding-my-motivation-slowly/" class="text-accent hover:underline font-semibold">rebuilding my motivation, slowly</a>), and always building Lego.
        </p>
      </section>

      <section>
        <h2 class="mb-3">
          <a
            href="/reading/"
            class="group inline-flex items-center gap-2 text-2xl font-bold text-primary tracking-wide hover:text-accent transition-colors"
          >
            READING
            <svg
              class="w-5 h-5 text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        </h2>
        <div class="flex gap-6 items-start flex-wrap">
          {currentlyReading.map((book) => (
            <div class="w-24 shrink-0">
              <ReadingCover book={book} cloudName={cloudName} eager />
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3 text-primary tracking-wide">WORK</h2>
        <p class="text-lg leading-relaxed">
          I'm an Engineering Manager at Business Insider, focused on user engagement and newsroom tools.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3 text-primary tracking-wide">SIDE HUSTLE</h2>
        <p class="text-lg leading-relaxed">
          Building a photography business — <a href="https://sessions.reubeningber.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-semibold">sessions.reubeningber.com</a> — and the brand on Instagram, <a href="https://instagram.com/photosessionswithreuben" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-semibold">@photosessionswithreuben</a>. Finished my test shoots and now figuring out some social/local advertising.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3 text-primary tracking-wide">LEARNING</h2>
        <p class="text-lg leading-relaxed">
          Continuing to go deep on AI, focused on improving how it helps me at work and, more importantly, how it can make life and family management easier — most recently by <a href="https://reubeningber.com/articles/2026-08-12-i-kept-failing-to-build-this-then-i-stopped-being-the-one-running-it/" class="text-accent hover:underline font-semibold">no longer being the one running things</a>.
        </p>
      </section>
    </div>

    <div class="mt-16 pt-6 border-t border-gray-200 text-sm text-secondary">
      <p>Last updated on September 18, 2026</p>
      <p>Inspired by <a href="https://sive.rs/nowff" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">sive.rs/nowff</a></p>
    </div>
  </div>
</Base>
