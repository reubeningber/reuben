---
import Base from "../layouts/BaseLayout.astro";
import ReadingCover from "../components/ReadingCover.astro";

import books2026 from "../data/reading/2026.json";
import books2025 from "../data/reading/2025.json";
import books2024 from "../data/reading/2024.json";
import books2023 from "../data/reading/2023.json";
import books2022 from "../data/reading/2022.json";
import books2021 from "../data/reading/2021.json";
import books2020 from "../data/reading/2020.json";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;

const years = [
  { year: 2026, books: books2026 },
  { year: 2025, books: books2025 },
  { year: 2024, books: books2024 },
  { year: 2023, books: books2023 },
  { year: 2022, books: books2022 },
  { year: 2021, books: books2021 },
  { year: 2020, books: books2020 },
];

const defaultYear = 2026;

const allBooks = years.flatMap(({ books }) => books);
---
<Base
  title="Reading | Reuben Ingber"
  description="A running record of the books I've read each year, going back to 2020."
>
  <div class="max-w-4xl">
    <h1 class="text-4xl font-bold mb-4 text-primary tracking-wide">READING</h1>

    <p class="text-lg leading-relaxed mb-8 text-secondary">
      A running record of the books I've read each year.
    </p>

    <div class="relative mb-8">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-secondary"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
      </svg>
      <input
        type="search"
        id="reading-search"
        placeholder="Search by title or author…"
        aria-label="Search books by title or author"
        class="w-full rounded-full border border-gray-200 py-2.5 pl-10 pr-4 text-lg leading-relaxed placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
      />
    </div>

    <div id="year-browser">
      <div role="tablist" aria-label="Reading year" class="flex flex-wrap gap-2 mb-8 border-b border-gray-200 pb-4">
        {years.map(({ year, books }) => (
          <button
            type="button"
            role="tab"
            data-year={year}
            aria-selected={year === defaultYear ? "true" : "false"}
            class:list={[
              "year-tab px-4 py-2 text-sm font-semibold tracking-wide rounded-full transition-colors",
              year === defaultYear
                ? "bg-orange-600 text-white"
                : "bg-gray-100 text-gray-700 hover:bg-gray-200",
            ]}
          >
            {year} <span class="opacity-70">({books.length})</span>
          </button>
        ))}
      </div>

      {years.map(({ year, books }) => (
        <div
          role="tabpanel"
          data-year-panel={year}
          class:list={["year-panel", year !== defaultYear && "hidden"]}
        >
          <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6">
            {books.map((book) => (
              <ReadingCover book={book} cloudName={cloudName} />
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="search-results" class="hidden">
      <p id="search-results-count" class="text-sm text-secondary mb-4"></p>
      <p id="search-results-empty" class="hidden text-lg text-secondary">No books match that search.</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6">
        {allBooks.map((book) => (
          <ReadingCover book={book} cloudName={cloudName} />
        ))}
      </div>
    </div>

    <div class="mt-16 pt-6 border-t border-gray-200 text-sm text-secondary">
      <p>Last updated on August 12, 2026 | Tracked on <a href="https://www.goodreads.com/user/show/7384813" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Goodreads</a></p>
    </div>
  </div>
</Base>

<script>
  function loadPanelImages(panel: Element) {
    panel.querySelectorAll<HTMLImageElement>('img.cover-img[data-src]').forEach((img) => {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    });
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('.year-tab');
  const panels = document.querySelectorAll<HTMLElement>('.year-panel');

  function activateYear(year: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.year === year;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.classList.toggle('bg-orange-600', active);
      tab.classList.toggle('text-white', active);
      tab.classList.toggle('bg-gray-100', !active);
      tab.classList.toggle('text-gray-700', !active);
    });
    panels.forEach((panel) => {
      const match = panel.dataset.yearPanel === year;
      panel.classList.toggle('hidden', !match);
      if (match) loadPanelImages(panel);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateYear(tab.dataset.year!));
  });

  // Load the initially active panel's images on page load.
  const initialPanel = document.querySelector<HTMLElement>('.year-panel:not(.hidden)');
  if (initialPanel) loadPanelImages(initialPanel);

  const searchInput = document.getElementById('reading-search') as HTMLInputElement;
  const yearBrowser = document.getElementById('year-browser')!;
  const searchResults = document.getElementById('search-results')!;
  const searchResultsCount = document.getElementById('search-results-count')!;
  const searchResultsEmpty = document.getElementById('search-results-empty')!;
  const searchCards = searchResults.querySelectorAll<HTMLAnchorElement>('a[data-title]');

  function loadCardImage(card: HTMLElement) {
    const img = card.querySelector<HTMLImageElement>('img[data-src]');
    if (img) {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    }
  }

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();

    if (!query) {
      searchResults.classList.add('hidden');
      yearBrowser.classList.remove('hidden');
      return;
    }

    yearBrowser.classList.add('hidden');
    searchResults.classList.remove('hidden');

    let matchCount = 0;
    searchCards.forEach((card) => {
      const match = card.dataset.title!.includes(query) || card.dataset.author!.includes(query);
      card.classList.toggle('hidden', !match);
      if (match) {
        matchCount++;
        loadCardImage(card);
      }
    });

    searchResultsEmpty.classList.toggle('hidden', matchCount > 0);
    searchResultsCount.textContent = matchCount > 0 ? `${matchCount} book${matchCount === 1 ? '' : 's'} found` : '';
  });
</script>
