---
import Base from "../layouts/BaseLayout.astro";
import ReadingCover from "../components/ReadingCover.astro";
import { STAR_FILLED, STAR_EMPTY } from "../utils/icons";

import books2026 from "../data/reading/2026.json";
import books2025 from "../data/reading/2025.json";
import books2024 from "../data/reading/2024.json";
import books2023 from "../data/reading/2023.json";
import books2022 from "../data/reading/2022.json";
import books2021 from "../data/reading/2021.json";
import books2020 from "../data/reading/2020.json";

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;

const years = [
  { year: 2026, books: books2026 },
  { year: 2025, books: books2025 },
  { year: 2024, books: books2024 },
  { year: 2023, books: books2023 },
  { year: 2022, books: books2022 },
  { year: 2021, books: books2021 },
  { year: 2020, books: books2020 },
];

const defaultYear = 2026;

const allBooks = years.flatMap(({ books }) => books);
const audioCount = allBooks.filter((book) => book.audio).length;
---
<Base
  title="Reading | Reuben Ingber"
  description="A running record of the books I've read each year, going back to 2020."
>
  <div class="max-w-4xl">
    <h1 class="text-4xl font-bold mb-4 text-primary tracking-wide">READING</h1>

    <p class="text-lg leading-relaxed mb-8 text-secondary">
      A running record of the books I've read each year.
    </p>

    <div class="relative mb-8 flex items-center gap-2">
      <div class="relative flex-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-5 w-5 text-secondary"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
        </svg>
        <input
          type="search"
          id="reading-search"
          placeholder="Search by title or author…"
          aria-label="Search books by title or author"
          class="w-full rounded-full border border-gray-200 py-2.5 pl-10 pr-4 text-lg leading-relaxed placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
        />
      </div>

      <div class="relative shrink-0">
        <button
          type="button"
          id="filters-toggle"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="filters-panel"
          class="relative flex items-center gap-1.5 rounded-full border border-gray-200 px-4 py-2.5 text-sm font-semibold tracking-wide text-gray-700 hover:bg-gray-100 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10M10 18h4" />
          </svg>
          Filters
          <span
            id="filters-count-badge"
            class="hidden ml-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-orange-600 text-[10px] font-bold text-white"
          ></span>
        </button>

        <div
          id="filters-panel"
          class="hidden absolute right-0 z-10 mt-2 w-64 rounded-2xl border border-gray-200 bg-white p-4 shadow-lg"
        >
          <div class="mb-4">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-secondary">Format</p>
            <button
              type="button"
              id="audio-filter-toggle"
              aria-pressed="false"
              aria-label={`Filter to audiobooks (${audioCount})`}
              class="audio-filter-toggle flex items-center gap-1.5 px-3 py-2 text-sm font-semibold tracking-wide rounded-full transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M12 4C7.58172 4 4 7.58172 4 12H7C8.10457 12 9 12.8954 9 14V19C9 20.1046 8.10457 21 7 21H4C2.89543 21 2 20.1046 2 19V12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12V19C22 20.1046 21.1046 21 20 21H17C15.8954 21 15 20.1046 15 19V14C15 12.8954 15.8954 12 17 12H20C20 7.58172 16.4183 4 12 4ZM4 14V19H7V14H4ZM17 14V19H20V14H17Z"></path></svg>
              Audiobooks
              <span class="opacity-70">({audioCount})</span>
            </button>
          </div>

          <div class="mb-4">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-secondary">Rating</p>
            <div id="rating-filter" class="flex items-center gap-1" role="group" aria-label="Minimum rating filter">
              {[1, 2, 3, 4, 5].map((n) => (
                <button
                  type="button"
                  class="rating-star relative block h-5 w-5 p-0.5 text-gray-300 hover:text-accent transition-colors"
                  data-rating-value={n}
                  aria-label={`${n} star${n === 1 ? "" : "s"} and up`}
                  aria-pressed="false"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="star-empty absolute inset-0.5 h-4 w-4" set:html={STAR_EMPTY} />
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="star-filled absolute inset-0.5 hidden h-4 w-4" set:html={STAR_FILLED} />
                </button>
              ))}
            </div>
            <p id="rating-filter-label" class="mt-1.5 text-xs text-secondary">Any rating</p>
          </div>

          <button
            type="button"
            id="clear-filters"
            class="w-full rounded-full border border-gray-200 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100 transition-colors"
          >
            Clear filters
          </button>
        </div>
      </div>
    </div>

    <div id="year-browser">
      <div role="tablist" aria-label="Reading year" class="hidden sm:flex flex-nowrap items-center gap-1.5 mb-8 border-b border-gray-200 pb-4 overflow-x-auto">
        {years.map(({ year, books }) => (
          <button
            type="button"
            role="tab"
            data-year={year}
            aria-selected={year === defaultYear ? "true" : "false"}
            class:list={[
              "year-tab shrink-0 px-3 py-2 text-sm font-semibold tracking-wide rounded-full transition-colors",
              year === defaultYear
                ? "bg-orange-600 text-white"
                : "bg-gray-100 text-gray-700 hover:bg-gray-200",
            ]}
          >
            {year} <span class="opacity-70">({books.length})</span>
          </button>
        ))}
      </div>

      <div class="sm:hidden mb-8">
        <label for="year-filter-select" class="sr-only">Filter by year</label>
        <select
          id="year-filter-select"
          class="w-full rounded-full border border-gray-200 py-2.5 px-4 text-sm font-semibold tracking-wide bg-gray-100 text-gray-700 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
        >
          {years.map(({ year, books }) => (
            <option value={year} selected={year === defaultYear}>{year} ({books.length})</option>
          ))}
        </select>
      </div>

      <div id="year-panels">
        {years.map(({ year, books }) => (
          <div
            role="tabpanel"
            data-year-panel={year}
            class:list={["year-panel", year !== defaultYear && "hidden"]}
          >
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6">
              {books.map((book) => (
                <ReadingCover book={book} cloudName={cloudName} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div id="search-results" class="hidden">
      <p id="search-results-count" class="text-sm text-secondary mb-4"></p>
      <p id="search-results-empty" class="hidden text-lg text-secondary">No books match that search.</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-6">
        {allBooks.map((book) => (
          <ReadingCover book={book} cloudName={cloudName} />
        ))}
      </div>
    </div>

    <div class="mt-16 pt-6 border-t border-gray-200 text-sm text-secondary">
      <p>Last updated on August 12, 2026 | Tracked on <a href="https://www.goodreads.com/user/show/7384813" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Goodreads</a></p>
    </div>
  </div>
</Base>

<script>
  function loadPanelImages(panel: Element) {
    panel.querySelectorAll<HTMLImageElement>('img.cover-img[data-src]').forEach((img) => {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    });
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('.year-tab');
  const panels = document.querySelectorAll<HTMLElement>('.year-panel');

  let currentYear = document.querySelector<HTMLButtonElement>('.year-tab[aria-selected="true"]')!.dataset.year!;

  // When a search/audio filter is active, no single year tab is "selected" since results span all years.
  function updateYearTabHighlight(filtered: boolean) {
    tabs.forEach((tab) => {
      const active = !filtered && tab.dataset.year === currentYear;
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.classList.toggle('bg-orange-600', active);
      tab.classList.toggle('text-white', active);
      tab.classList.toggle('bg-gray-100', !active);
      tab.classList.toggle('text-gray-700', !active);
    });
  }

  function activateYear(year: string) {
    currentYear = year;
    updateYearTabHighlight(false);
    panels.forEach((panel) => {
      const match = panel.dataset.yearPanel === year;
      panel.classList.toggle('hidden', !match);
      if (match) loadPanelImages(panel);
    });
  }

  // Load the initially active panel's images on page load.
  const initialPanel = document.querySelector<HTMLElement>('.year-panel:not(.hidden)');
  if (initialPanel) loadPanelImages(initialPanel);

  const searchInput = document.getElementById('reading-search') as HTMLInputElement;
  const audioToggle = document.getElementById('audio-filter-toggle') as HTMLButtonElement;
  const yearSelect = document.getElementById('year-filter-select') as HTMLSelectElement;
  const yearPanels = document.getElementById('year-panels')!;
  const searchResults = document.getElementById('search-results')!;
  const searchResultsCount = document.getElementById('search-results-count')!;
  const searchResultsEmpty = document.getElementById('search-results-empty')!;
  const searchCards = searchResults.querySelectorAll<HTMLAnchorElement>('a[data-title]');

  const filtersToggle = document.getElementById('filters-toggle') as HTMLButtonElement;
  const filtersPanel = document.getElementById('filters-panel')!;
  const filtersCountBadge = document.getElementById('filters-count-badge')!;
  const clearFiltersButton = document.getElementById('clear-filters') as HTMLButtonElement;
  const ratingStars = document.querySelectorAll<HTMLButtonElement>('.rating-star');
  const ratingFilterLabel = document.getElementById('rating-filter-label')!;

  function setAudioToggleStyle(active: boolean) {
    audioToggle.setAttribute('aria-pressed', String(active));
    audioToggle.classList.toggle('bg-orange-600', active);
    audioToggle.classList.toggle('text-white', active);
    audioToggle.classList.toggle('bg-gray-100', !active);
    audioToggle.classList.toggle('text-gray-700', !active);
  }

  function selectYear(year: string) {
    // Selecting a year always returns to plain year browsing, clearing any active filters.
    searchInput.value = '';
    audioOnly = false;
    setAudioToggleStyle(false);
    setMinRating(0);
    searchResults.classList.add('hidden');
    yearPanels.classList.remove('hidden');
    activateYear(year);
    yearSelect.value = year;
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => selectYear(tab.dataset.year!));
  });

  yearSelect.addEventListener('change', () => selectYear(yearSelect.value));

  function loadCardImage(card: HTMLElement) {
    const img = card.querySelector<HTMLImageElement>('img[data-src]');
    if (img) {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    }
  }

  let audioOnly = false;
  let minRating = 0;

  function updateFiltersBadge() {
    const activeCount = [audioOnly, minRating > 0].filter(Boolean).length;
    filtersCountBadge.textContent = String(activeCount);
    filtersCountBadge.classList.toggle('hidden', activeCount === 0);
  }

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();

    updateFiltersBadge();

    const filtered = Boolean(query || audioOnly || minRating > 0);
    updateYearTabHighlight(filtered);

    if (!filtered) {
      searchResults.classList.add('hidden');
      yearPanels.classList.remove('hidden');
      return;
    }

    yearPanels.classList.add('hidden');
    searchResults.classList.remove('hidden');

    let matchCount = 0;
    searchCards.forEach((card) => {
      const match =
        (!query || card.dataset.title!.includes(query) || card.dataset.author!.includes(query)) &&
        (!audioOnly || card.dataset.audio === 'true') &&
        Number(card.dataset.rating) >= minRating;
      card.classList.toggle('hidden', !match);
      if (match) {
        matchCount++;
        loadCardImage(card);
      }
    });

    searchResultsEmpty.classList.toggle('hidden', matchCount > 0);
    searchResultsCount.textContent = matchCount > 0 ? `${matchCount} book${matchCount === 1 ? '' : 's'} found` : '';
  }

  searchInput.addEventListener('input', applyFilters);

  function setAudioOnly(value: boolean) {
    audioOnly = value;
    setAudioToggleStyle(audioOnly);
    applyFilters();
  }

  audioToggle.addEventListener('click', () => setAudioOnly(!audioOnly));

  function setRatingStarStyle() {
    ratingStars.forEach((star) => {
      const value = Number(star.dataset.ratingValue);
      const active = value <= minRating;
      star.classList.toggle('text-accent', active);
      star.classList.toggle('text-gray-300', !active);
      star.setAttribute('aria-pressed', String(active));
      star.querySelector('.star-filled')!.classList.toggle('hidden', !active);
      star.querySelector('.star-empty')!.classList.toggle('hidden', active);
    });
    ratingFilterLabel.textContent = minRating > 0 ? `${minRating}★ & up` : 'Any rating';
  }

  function setMinRating(value: number) {
    minRating = value;
    setRatingStarStyle();
    applyFilters();
  }

  ratingStars.forEach((star) => {
    star.addEventListener('click', () => {
      const value = Number(star.dataset.ratingValue);
      setMinRating(value === minRating ? 0 : value);
    });
  });

  clearFiltersButton.addEventListener('click', () => {
    setAudioOnly(false);
    setMinRating(0);
  });

  function openFiltersPanel() {
    filtersPanel.classList.remove('hidden');
    filtersToggle.setAttribute('aria-expanded', 'true');
  }

  function closeFiltersPanel() {
    filtersPanel.classList.add('hidden');
    filtersToggle.setAttribute('aria-expanded', 'false');
  }

  filtersToggle.addEventListener('click', () => {
    if (filtersPanel.classList.contains('hidden')) {
      openFiltersPanel();
    } else {
      closeFiltersPanel();
    }
  });

  document.addEventListener('click', (event) => {
    if (!filtersPanel.contains(event.target as Node) && event.target !== filtersToggle && !filtersToggle.contains(event.target as Node)) {
      closeFiltersPanel();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeFiltersPanel();
  });
</script>
